# 统一换行，避免 Windows/Mac 协作时的 CRLF 噪音
* text=auto eol=lf

# 明确文本类型
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.md     text eol=lf
*.svg    text eol=lf
*.json   text eol=lf

# 二进制
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ico    binary
